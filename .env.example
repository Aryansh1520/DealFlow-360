# ── Application ──────────────────────────────────────────────
APP_NAME=DealFlow360
APP_ENV=production
ENVIRONMENT=production
DEBUG=true
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8001

# ── Database ─────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
# Used when running the backend outside Docker (compose overrides host to db)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/app

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS (comma-separated origins) ───────────────────────────
CORS_ORIGINS=http://localhost:3001

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Files ────────────────────────────────────────────────────
UPLOAD_DIR=uploads

# ── Redis / task queue (Dramatiq) ────────────────────────────
# Used when running the backend/worker outside Docker (compose overrides host to redis)
REDIS_URL=redis://localhost:6379/0

# ── Rate limiting (in-memory, per IP + per account) ──────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW_SECONDS=60

# ── MinIO / object storage ────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=dealflow360
MINIO_SECURE=false
# Used when running the backend/worker outside Docker (compose overrides host to minio:9000)
MINIO_ENDPOINT=localhost:9000

# ── URLs ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3001

# ── Seed admin user (created on first startup) ───────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# ── Frontend (NEXT_PUBLIC_* are baked in at build time) ──────
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1
NEXT_PUBLIC_APP_NAME=DealFlow360
