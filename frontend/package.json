{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "openapi-typescript ../backend/openapi.json -o src/lib/api/schema.d.ts && next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript http://localhost:8001/api/v1/openapi.json -o src/lib/api/schema.d.ts",
    "gen:api:file": "openapi-typescript ../backend/openapi.json -o src/lib/api/schema.d.ts",
    "check:api": "openapi-typescript ../backend/openapi.json -o src/lib/api/schema.d.ts && git diff --exit-code -- src/lib/api/schema.d.ts ../backend/openapi.json",
    "check:money": "! grep -rn '_minor' src --include='*.ts' --include='*.tsx' | grep '/ 100' | grep -v 'src/lib/money.ts' | grep -v 'src/components/ui/money-input.tsx'"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@tanstack/react-query": "^5.76.0",
    "axios": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.503.0",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
